# Public Supabase values. Required for live listings and submissions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only integrations. Leave blank to keep the integration disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BREVO_API_KEY=
BREVO_LIST_ID=

# Required for internal announce, queue, notify, and diagnostic calls.
HACKLIST_INTERNAL_API_SECRET=

# Disabled by default. Enabling this does not create a durable queue; do so
# only after the approved queue worker is deployed and reviewed.
HACKLIST_ANNOUNCE_ENABLED=false
